NEBIUS_API_KEY=...
# Optional overrides for the Nebius OpenAI-compatible endpoint:
# NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
TAVILY_API_KEY=...

ELEVENLABS_API_KEY=...
# Optional overrides for ElevenLabs TTS:
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=XjLkpWUlnhS8i7gGz3lZ

# Firebase Storage for voice-over audio (mirrored under the "neoflix/" root and
# served from public download URLs).
FIREBASE_SERVICE_ACCOUNT_BASE64=...
# FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app

# Story store: "file" (default, JSON under src/data/stories) or "neo4j"
# (the graph shared with news-scraper). Media caches always stay on disk.
# STORY_STORE=file
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=...
# NEO4J_DATABASE=neo4j
# Graph-first research (neo4j only): fresh graph hits needed to skip Tavily,
# and how many days back an Article counts as fresh.
# GRAPH_MIN_HITS=5
# GRAPH_FRESH_DAYS=30
# Trend sync worker (npm run sync:trends, neo4j only): least TRENDED traffic a
# topic needs (0 also admits unknown traffic), how old a matching story must
# be before it is refreshed, per-cycle caps, and the --loop interval.
# TREND_TRAFFIC_FLOOR=1000
# REFRESH_MIN_HOURS=6
# MAX_NEW_STORIES_PER_CYCLE=3
# MAX_REFRESHES_PER_CYCLE=5
# SYNC_INTERVAL_MINUTES=30
