NEBIUS_API_KEY=...
# Optional overrides for the Nebius OpenAI-compatible endpoint:
# NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Nemotron Nano answers "Ask the story" (grounded Q&A); story compilation
# keeps using NEBIUS_MODEL.
# NEBIUS_ASK_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
TAVILY_API_KEY=...

ELEVENLABS_API_KEY=...
# Optional overrides for ElevenLabs TTS:
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=XjLkpWUlnhS8i7gGz3lZ

# Firebase Storage for voice-over audio (mirrored under the "neoflix/" root and
# served from public download URLs).
FIREBASE_SERVICE_ACCOUNT_BASE64=...
# FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app

# Story store: "file" (default, JSON under src/data/stories) or "neo4j"
# (the graph shared with news-scraper). Media caches always stay on disk.
# STORY_STORE=file
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=...
# NEO4J_DATABASE=neo4j
# Graph-first research (neo4j only): fresh graph hits needed to skip Tavily,
# and how many days back an Article counts as fresh.
# GRAPH_MIN_HITS=5
# GRAPH_FRESH_DAYS=30
# Trend sync worker (npm run sync:trends, neo4j only): least TRENDED traffic a
# topic needs (0 also admits unknown traffic) and the --loop interval. The
# worker only scrapes, classifies and links — stories are researched when a
# reader opens them.
# TREND_TRAFFIC_FLOOR=1000
# SYNC_INTERVAL_MINUTES=30

# Trend scraper (runs at the start of every sync:trends cycle): the Google
# Trends daily-search feeds to read, items kept per feed, headlines kept per
# item, and the per-feed fetch timeout. SCRAPE_ITEM_LIMIT=0 disables scraping.
# SCRAPE_GEOS=US,GB,IN,BR,DE,JP,AU,CA
# SCRAPE_ITEM_LIMIT=20
# SCRAPE_HEADLINES_PER_ITEM=5
# SCRAPE_TIMEOUT_MS=15000
